---
import { Image } from "astro:assets";

// Dynamically import all images from the logos directory
// Using import.meta.glob is cleaner in Astro for this purpose usually, but Astro.glob is also standard.
// We'll use Astro.glob to catch all standard image formats.
const logoFiles = await Astro.glob(
    "/src/assets/theme-images/home/logos/*.{jpeg,jpg,png,gif,svg,webp}",
);

const hasLogos = logoFiles.length > 0;
---

<section class="py-24 relative overflow-hidden">
    <div class="bs-container relative z-10">
        <div class="text-center mb-16">
            <h2 class="bs-h2 mb-6">Our Clients</h2>
            <!-- Decorative underline -->
            <div
                class="h-1 w-24 bg-gradient-to-r from-purple-500 to-blue-500 mx-auto rounded-full"
            >
            </div>
        </div>

        {
            hasLogos ? (
                <div class="columns-2 md:columns-3 lg:columns-4 gap-6">
                    {logoFiles.map((logo) => (
                        <div class="break-inside-avoid mb-6">
                            <div class="bg-white/5 border border-white/10 rounded-xl p-8 flex items-center justify-center hover:bg-white/10 hover:border-white/20 transition-all duration-500 group relative overflow-hidden">
                                {/* Subtle glow effect on hover */}
                                <div class="absolute inset-0 bg-gradient-to-br from-purple-500/10 to-blue-500/10 opacity-0 group-hover:opacity-100 transition-opacity duration-500" />

                                <Image
                                    src={logo.default}
                                    alt="Client Logo"
                                    class="relative z-10 w-full h-auto max-h-24 object-contain opacity-90 group-hover:opacity-100 transition-all duration-500 filter"
                                />
                            </div>
                        </div>
                    ))}
                </div>
            ) : (
                <div class="text-center p-12 border border-dashed border-white/10 rounded-xl bg-white/5 animate-pulse">
                    <div class="flex flex-col items-center justify-center gap-4">
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="48"
                            height="48"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.5"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            class="text-white/20"
                        >
                            <>
                                <rect
                                    width="18"
                                    height="18"
                                    x="3"
                                    y="3"
                                    rx="2"
                                    ry="2"
                                />
                                <circle cx="9" cy="9" r="2" />
                                <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21" />
                            </>
                        </svg>
                        <div>
                            <p class="text-bs-foreground-light font-medium">
                                No Logo Images Found
                            </p>
                            <p class="text-sm text-bs-foreground-light/60 mt-1">
                                Add logo images to{" "}
                                <code class="bg-black/30 px-2 py-0.5 rounded text-xs select-all">
                                    src/assets/theme-images/home/logos/
                                </code>{" "}
                                to see them here.
                            </p>
                        </div>
                    </div>
                </div>
            )
        }
    </div>

    <div
        class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[80%] h-[80%] bg-purple-900/20 rounded-full blur-[120px] -z-10 pointer-events-none"
    >
    </div>
</section>
