---
interface Props {
  title: string;
  subtitle: string;
  cards: {
    challenge: {
      title: string;
      description: string;
    };
    solution: {
      agentName: string;
      description: string;
    };
    modalContent?: {
      title?: string;
      content?: string[];
      role?: string;
      roleSummary?: string;
      responsibilities?: string[];
      deliverables?: string[];
      cta?: {
        text: string;
        link: string;
      };
    };
    visualHTML: string;
  }[];
}

const { title, subtitle, cards } = Astro.props;

import visualHTML from "../assets/theme-images/home/Home-Section1-Brainy.png";
import visualModalHTML from "../assets/theme-images/home/home-popup-brainy.png";

import visualHTML2 from "../assets/theme-images/home/Home-Section1-Noggin.png";
import visualModalHTML2 from "../assets/theme-images/home/home-popup-noggin.png";

import visualHTML3 from "../assets/theme-images/home/Home-Section1-REM.png";
import visualModalHTML3 from "../assets/theme-images/home/home-popup-rem.png";
import PainToPromiseModal from "./PainToPromiseModal.astro";
---

<section
  class="mx-auto px-4 py-20 sm:py-32 text-center opacity-0 intersect:opacity-100 transition-opacity intersect:duration-500"
>
  <div class="bs-container">
    <h2 class="bs-h1 text-4xl text-gradient">{title}</h2>
    <h4 class="bs-h3 mt-12 md:max-w-1/2 mx-auto text-2xl text-gradient">
      {subtitle}
    </h4>
    <div class="flex md:flex-row flex-col gap-12 py-24">
      <div
        class="main-fixed-content flex flex-col gap-6 text-left sticky top-20 md:top-50 z-20 md:z-10 h-fit"
      >
        {
          cards.map((card, index) => (
            <div
              class={`card-content mobile-float-card !absolute md:!relative card-item-${index} opacity-30 transition-opacity duration-600 w-full bg-black/30 p-4 ai-card rounded-lg backdrop-blur-md border-transparent [background:linear-gradient(120deg,rgba(255,255,255,0.1),transparent_100%,rgba(255,255,255,0.1))_border-box] [mask-composite:exclude]`}
            >
              <div class="space-y-3 ">
                <div class="flex flex-col justify-between  p-2 rounded-md text-left z-2">
                  <span class="bs-h2 text-gradient z-2">
                    {card.challenge.title}
                  </span>
                  <span class=" text-lg md:max-w-10/12 mt-4  py-1 text-gray-100 z-2">
                    {card.challenge.description}
                  </span>
                </div>
              </div>
            </div>
          ))
        }
      </div>
      <div class="main-scroll-content sticky top-0 z-10 h-full">
        <div class="flex gap-6 flex-col">
          {
            cards.map((card, index) => (
              <div class="card-content ai-card rounded-2xl w-full backdrop-blur-md border-transparent opacity-0 transition-opacity duration-700 [background:linear-gradient(120deg,rgba(255,255,255,0.1),transparent_50%,rgba(255,255,255,0.1))_border-box] [mask-composite:exclude]">
                <div class="space-y-3 relative overflow-hidden min-h-80 py-8 px-6">
                  <div class="flex flex-col justify-between text-left bg-gray-900/20 p-2 rounded-md">
                    <div class="flex flex-col max-w-2/3 z-2">
                      <span class="text-sm text-white text-gradient bs-h2">
                        {card.solution.agentName}
                      </span>
                      <span
                        class="relative
                    mt-4
                    before:absolute before:inset-0 before:animate-typewriter
                    text-xl
                    "
                      >
                        {card.solution.description}
                      </span>
                      <button
                        onclick={
                          card.modalContent
                            ? `bb_track('cta_click', { cta_name: 'See How ${card.solution.agentName} Works', cta_location: 'pain_to_promise' }); document.getElementById('paintopromise-modal-${index}').showModal();`
                            : `bb_track('cta_click', { cta_name: 'See How ${card.solution.agentName} Works', cta_location: 'pain_to_promise' }); demo.showModal();`
                        }
                        class="bs-btn mt-4 opacity-0 transition-opacity duration-600 intersect:opacity-100 intersect-full"
                      >
                        see how {card.solution.agentName} works
                      </button>
                    </div>

                    {/* add an image depending on the index */}
                    {index === 0 && (
                      <img
                        class="absolute bottom-0 md:top-0 right-0 z-2 max-w-36 object-contain md:max-w-52 md:h-full"
                        style="filter:grayscale(40%)"
                        src={visualHTML.src}
                        alt=""
                        loading="lazy"
                      />
                    )}
                    {index === 1 && (
                      <img
                        class="absolute bottom-0 md:top-0 right-0 z-2 max-w-36 object-contain md:max-w-52 md:h-full"
                        style="filter:grayscale(40%)"
                        src={visualHTML2.src}
                        alt=""
                        loading="lazy"
                      />
                    )}
                    {index === 2 && (
                      <img
                        class="absolute bottom-0 md:top-0 right-0 z-2 max-w-36 object-contain md:max-w-52 md:h-full "
                        style="filter:grayscale(40%)"
                        src={visualHTML3.src}
                        alt=""
                        loading="lazy"
                      />
                    )}
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
    {/* Render modals at the bottom of the component */}
    {
      cards.map(
        (card, index) =>
          card.modalContent && (
            <PainToPromiseModal
              modal={{ ...card, ...card.modalContent }}
              index={index}
              image={
                index === 0
                  ? visualModalHTML.src
                  : index === 1
                    ? visualModalHTML2.src
                    : visualModalHTML3.src
              }
            />
          ),
      )
    }
  </div>

  <style>
    @media (max-width: 640px) {
      .main-fixed-content {
        min-height: 19rem;
      }
      .mobile-float-card {
        opacity: 0;
      }
      .mobile-float-card.opacity-100 {
        opacity: 1;
      }
    }
  </style>

  <script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
      const scrollableContent = document.querySelector(".main-scroll-content");
      const fixedContent = document.querySelector(".main-fixed-content");

      if (!scrollableContent || !fixedContent) {
        console.error("Required scroll or fixed content elements not found.");
        return;
      }
      const cardDefinitions =
        scrollableContent.querySelectorAll(".card-content");
      const items = fixedContent.querySelectorAll(".card-content");
      const cardCount = items.length;

      if (cardCount === 0) return;

      function setActiveCard(activeIndex, cardDefinitions) {
        if (activeIndex < 0 || activeIndex >= cardCount) return;

        items.forEach((item, index) => {
          if (index === activeIndex) {
            item.classList.add("opacity-100");
            item.classList.remove("opacity-30");
            cardDefinitions[index].classList.add("opacity-100");
            cardDefinitions[index].classList.remove("opacity-30");
          } else {
            item.classList.add("opacity-30");
            item.classList.remove("opacity-100");
            cardDefinitions[index].classList.add("opacity-30");
            cardDefinitions[index].classList.remove("opacity-100");
          }
        });
      }

      window.addEventListener(
        "scroll",
        () => {
          const scrollableContentRect =
            scrollableContent.getBoundingClientRect();
          const top = scrollableContentRect.top;

          let activeIndex = -1;

          if (window.innerWidth < 640) {
            if (top <= 960 && top > 22) {
              activeIndex = 0;
            } else if (top <= 23 && top > -245) {
              activeIndex = 1;
            } else if (top <= -245) {
              activeIndex = 2;
            }
          } else {
            if (top <= 960 && top > 85) {
              activeIndex = 0;
            } else if (top <= 85 && top > -65) {
              activeIndex = 1;
            } else if (top <= -145) {
              activeIndex = 2;
            }
          }

          if (activeIndex !== -1) {
            setActiveCard(activeIndex, cardDefinitions);
          }
        },
        { passive: true },
      );

      setActiveCard(0, cardDefinitions);
    });
  </script>
</section>
