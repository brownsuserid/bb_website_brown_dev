---
import Image from "astro/components/Image.astro";
import Logo from "../assets/theme-images/brainbridgelogo.png";

// Assuming 'settings' prop is passed from the parent page
const { settings } = Astro.props;
---

<footer
  class="relative pt-16 pb-8 px-4 sm:px-6 lg:px-8 font-semibold text-white overflow-hidden mt-10"
  id="contact"
>
  <div class="absolute inset-0 backdrop-blur-sm bg-black/10 opacity-50"></div>
  <div
    class="relative z-10 bs-container mx-auto grid grid-cols-1 md:grid-cols-3 lg:grid-cols-4 gap-12 md:gap-8 items-start"
  >
    <div class="flex flex-col gap-6 md:col-span-3 lg:col-span-2">
      <a class="flex items-center group" href="#top" aria-label="Back to top">
        <Image src={Logo} alt="" class="mr-3 max-w-45" />
      </a>
      <p class="text-sm text-white/70 font-medium leading-relaxed max-w-md">
        {settings.companyInfo.tagline}
      </p>
    </div>

    <div class="flex flex-col gap-4">
      <h3 class="text-lg font-bold text-gray-200">
        {settings.navigation.title}
      </h3>
      <nav class="flex flex-col gap-3">
        {
          settings.navigation.links.map((item) => (
            <a
              href={item.link}
              class="text-gray-400 hover:text-white font-medium transition-colors duration-200 text-base"
            >
              {item.title}
            </a>
          ))
        }
      </nav>
    </div>

    <div class="flex flex-col gap-4">
      <h3 class="text-lg font-bold text-gray-200">Ready to Get Started?</h3>
      <p class="text-base text-gray-400 font-medium">
        Let's build the future of your business together.
      </p>
      <button
        onclick="demo.showModal()"
        type="button"
        class="w-full bs-btn bg-red-600 hover:bg-red-700 text-white font-bold rounded-lg px-6 py-3 shadow-lg hover:shadow-xl transition-all duration-300 transform hover:scale-105 text-base"
      >
        {settings.ctaButton.title}
      </button>
    </div>
  </div>

  <div
    class="relative z-10 pt-8 mt-12 border-t border-gray-800 text-center text-sm"
  >
    <p>
      © {new Date().getFullYear()}
      {settings.companyInfo.name}. All rights reserved. <span
        class="text-gray-400 text-sm"
      >
        Site Developed with heart by <a
          href="https://orchidmedia.io/"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-white transition-colors duration-150 underline"
          >Orchid Media</a
        ></span
      >.
    </p>
  </div>
</footer>
