---

---

<canvas id="particle-canvas" class="absolute top-0 left-0 w-full h-full z-0"
></canvas>

<script>
  import * as THREE from "three";

  let scene, camera, renderer, particles;
  let mouse = new THREE.Vector2(-10, -10);
  let raycaster = new THREE.Raycaster();
  let plane;

  const SEPARATION = 100,
    AMOUNTX = 200,
    AMOUNTY = 70;
  const buttonPositions = {
    btn1: new THREE.Vector3(),
    btn2: new THREE.Vector3()
  };

  function init() {
    scene = new THREE.Scene();
    camera = new THREE.PerspectiveCamera(
      120,
      window.innerWidth / window.innerHeight,
      1,
      10000
    );
    camera.position.z = 1000;
    camera.position.y = 100;

    const canvas = document.getElementById("particle-canvas");
    renderer = new THREE.WebGLRenderer({ canvas, alpha: true });
    renderer.setSize(window.innerWidth, window.innerHeight);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

    plane = new THREE.Mesh(
      new THREE.PlaneGeometry(5000, 5000),
      new THREE.MeshBasicMaterial({ visible: false })
    );
    scene.add(plane);

    // --- Particle Geometry and Attributes ---
    const numParticles = AMOUNTX * AMOUNTY;
    const positions = new Float32Array(numParticles * 3);
    const chaosPositions = new Float32Array(numParticles * 3);
    const clarityPositions = new Float32Array(numParticles * 3);

    let i = 0;
    const SPREAD = 1000;
    for (let ix = 0; ix < AMOUNTX; ix++) {
      for (let iy = 0; iy < AMOUNTY; iy++) {
        // Clarity (final) position - LOWERED
        clarityPositions[i] = ix * SEPARATION - (AMOUNTX * SEPARATION) / 2; // x
        clarityPositions[i + 1] = -850; // y
        clarityPositions[i + 2] = iy * SEPARATION - (AMOUNTY * SEPARATION) / 2; // z

        // Chaos (initial) position
        chaosPositions[i] = (Math.random() - 0.5) * SPREAD * 10;
        chaosPositions[i + 1] = (Math.random() - 0.5) * SPREAD;
        chaosPositions[i + 2] = (Math.random() - 0.5) * SPREAD * 4 - 1000;

        positions[i] = chaosPositions[i];
        positions[i + 1] = chaosPositions[i + 1];
        positions[i + 2] = chaosPositions[i + 2];

        i += 3;
      }
    }

    const geometry = new THREE.BufferGeometry();
    geometry.setAttribute("position", new THREE.BufferAttribute(positions, 3));
    geometry.setAttribute(
      "aChaos",
      new THREE.BufferAttribute(chaosPositions, 3)
    );
    geometry.setAttribute(
      "aClarity",
      new THREE.BufferAttribute(clarityPositions, 3)
    );

    const material = new THREE.ShaderMaterial({
      uniforms: {
        color: { value: new THREE.Color(0xe1e1e1) },
        opacity: { value: 0.7 },
        uTime: { value: 0 },
        uProgress: { value: 0 },
        uMouse: { value: new THREE.Vector3() },
        uButton1: { value: buttonPositions.btn1 },
        uButton2: { value: buttonPositions.btn2 }
      },
      vertexShader: `
                    attribute vec3 aChaos;
                    attribute vec3 aClarity;
                    uniform float uTime;
                    uniform float uProgress;
                    uniform vec3 uMouse;
                    uniform vec3 uButton1;
                    uniform vec3 uButton2;
                    uniform vec3 uButton3;
                    varying float vBrightness;

                    void main() {
                        vec3 pos = mix(aChaos, aClarity, uProgress);

                        pos.y += (sin((pos.x / 100.0 + uTime) * 0.3) * 50.0) + (sin((pos.z / 100.0 + uTime) * 0.5) * 50.0);
                        
                        // Button hover interaction
                        float lift1 = smoothstep(200.0, 0.0, distance(uMouse, uButton1)) * 100.0;
                        float lift2 = smoothstep(200.0, 0.0, distance(uMouse, uButton2)) * 100.0;
                        float lift3 = smoothstep(200.0, 0.0, distance(uMouse, uButton3)) * 100.0;
                        
                        vBrightness = (lift1 + lift2 + lift3) * 0.01;
                        
                        pos.y += smoothstep(300.0, 0.0, distance(pos, uButton1)) * lift1;
                        pos.y += smoothstep(300.0, 0.0, distance(pos, uButton2)) * lift2;
                        pos.y += smoothstep(300.0, 0.0, distance(pos, uButton3)) * lift3;

                        // General mouse attraction
                        float distToMouse = distance(pos, uMouse);
                        float attractionFactor = 1.0 - smoothstep(0.0, 400.0, distToMouse);
                        vec3 directionToMouse = normalize(uMouse - pos);
                        pos += directionToMouse * attractionFactor * 75.0 * uProgress;

                        vec4 mvPosition = modelViewMatrix * vec4( pos, 1.0 );
                        
                        float scale = (sin((pos.x / 100.0 + uTime) * 0.3) + 1.0) * 1.5 + (sin((pos.z / 100.0 + uTime) * 0.5) + 1.0) * 1.5;
                        gl_PointSize = scale * ( 300.0 / -mvPosition.z );
                        gl_Position = projectionMatrix * mvPosition;
                    }
                `,
      fragmentShader: `
                    uniform vec3 color;
                    uniform float opacity;
                    varying float vBrightness;
                    void main() {
                        if ( length( gl_PointCoord - vec2( 0.5, 0.5 ) ) > 0.475 ) discard;
                        gl_FragColor = vec4( color, opacity + vBrightness );
                    }
                `,
      transparent: true,
      blending: THREE.AdditiveBlending,
      depthWrite: false,
    });

    particles = new THREE.Points(geometry, material);
    scene.add(particles);

    animateToClarity();
    updateButtonPositions();
    window.addEventListener("resize", onWindowResize);
    document.addEventListener("mousemove", onMouseMove);
  }

  function animateToClarity() {
    let progress = { value: 0 };
    const duration = 4000;
    const startTime = performance.now();
    function update() {
      const elapsedTime = performance.now() - startTime;
      if (elapsedTime < duration) {
        const t = elapsedTime / duration;
        progress.value = t * t * (3.0 - 2.0 * t);
        if (particles)
          particles.material.uniforms.uProgress.value = progress.value;
        requestAnimationFrame(update);
      } else {
        if (particles) particles.material.uniforms.uProgress.value = 1.0;
      }
    }
    update();
  }

  function updateButtonPositions() {
    if (!camera) return;
    const btn1 = document.getElementById("btn-diag");
    const btn2 = document.getElementById("btn-pro");
    if (!btn1 || !btn2) return;

    const toNDC = (btn) => {
      const rect = btn.getBoundingClientRect();
      const x = ((rect.left + rect.width / 2) / window.innerWidth) * 2 - 1;
      const y = (-(rect.top + rect.height / 2) / window.innerHeight) * 2 + 1;
      return new THREE.Vector3(x, y, 0);
    };
    const unproject = (vec) => {
      vec.unproject(camera);
      const dir = vec.sub(camera.position).normalize();
      const distance = -camera.position.z / dir.z;
      return camera.position.clone().add(dir.multiplyScalar(distance));
    };
    buttonPositions.btn1.copy(unproject(toNDC(btn1)));
    buttonPositions.btn2.copy(unproject(toNDC(btn2)));
  }

  function onWindowResize() {
    if (camera) {
      camera.aspect = window.innerWidth / window.innerHeight;
      camera.updateProjectionMatrix();
    }
    if (renderer) {
      renderer.setSize(window.innerWidth, window.innerHeight);
    }
    updateButtonPositions();
  }

  function onMouseMove(event) {
    mouse.x = (event.clientX / window.innerWidth) * 2 - 1;
    mouse.y = -(event.clientY / window.innerHeight) * 2 + 1;
  }

  function animate() {
    requestAnimationFrame(animate);

    const time = performance.now() * 0.001;
    if (particles) {
      particles.material.uniforms.uTime.value = time;
    }

    camera.lookAt(scene.position);

    raycaster.setFromCamera(mouse, camera);
    const intersects = raycaster.intersectObject(plane);
    if (intersects.length > 0) {
      if (particles) {
        particles.material.uniforms.uMouse.value.copy(intersects[0].point);
      }
    }

    renderer.render(scene, camera);
  }

  init();
  animate();
</script>
