---
// src/components/PainToPromiseModal.astro
const { modal, index, image } = Astro.props;
---

<dialog
  id={`paintopromise-modal-${index}`}
  class="fixed inset-0 bg-bs-surface-0 m-auto z-50 p-0 rounded-xl w-full max-w-[95%] md:max-w-6xl max-h-[90vh] overflow-hidden border border-gray-800"
>
  <button
    onclick="this.closest('dialog').close()"
    aria-label="Close"
    class="absolute top-4 left-4 z-50 bs-btn rounded-full !p-0 flex items-center justify-center h-10 w-10 bg-black/50 hover:bg-black/70 transition-colors text-white border border-white/20"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="24"
      height="24"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="w-6 h-6"
    >
      <line x1="18" y1="6" x2="6" y2="18"></line>
      <line x1="6" y1="6" x2="18" y2="18"></line>
    </svg>
  </button>

  <div class="h-full flex flex-col md:flex-row">
    <!-- Left Column: Image -->
    <div class="hidden md:block w-2/5 relative min-h-full bg-black">
      {
        image && (
          <img
            src={image}
            alt={modal.solution?.agentName || "AI Teammate"}
            class="w-full h-full object-cover object-[70%] opacity-90"
          />
        )
      }
      <div
        class="absolute inset-0 bg-gradient-to-r from-transparent to-bs-surface-0/20"
      >
      </div>
    </div>

    <!-- Right Column: Content -->
    <div
      class="w-full md:w-3/5 overflow-y-auto max-h-[90vh] p-8 md:p-12 bg-bs-surface-0 border-l border-white/5"
    >
      <div class="flex flex-col gap-8">
        <!-- Header -->
        <div>
          <h2 class="bs-h1 !text-3xl md:!text-4xl text-gradient mb-6">
            {modal.title || "TeamMate Position Description"}
          </h2>
          {
            modal.role && (
              <div class="flex items-baseline gap-2 text-xl md:text-2xl">
                <span class="font-bold text-white">Role:</span>
                <span class="text-gray-300">{modal.role}</span>
              </div>
            )
          }
        </div>

        {/* Role Summary */}
        <div class="text-left">
          <h3 class="text-xl font-bold text-white mb-3">Role Summary</h3>
          <p class="text-gray-400 leading-relaxed text-lg">
            {modal.roleSummary}
          </p>
        </div>

        {/* Core Responsibilities */}
        {
          modal.responsibilities && (
            <div class="text-left">
              <h3 class="text-xl font-bold text-white mb-3">
                Core Responsibilities
              </h3>
              <ul class="space-y-2 text-gray-400">
                {modal.responsibilities.map((item) => (
                  <li class="flex items-start">
                    <span class="mr-2 text-gray-500">-</span>
                    <span>{item.replace(/^-/, "")}</span>
                  </li>
                ))}
              </ul>
            </div>
          )
        }

        {/* Deliverables */}
        {
          modal.deliverables && (
            <div class="text-left">
              <h3 class="text-xl font-bold text-white mb-3">Deliverables</h3>
              <ul class="space-y-2 text-gray-400">
                {modal.deliverables.map((item) => (
                  <li class="flex items-start">
                    <span class="mr-2 text-gray-500">-</span>
                    <span>{item.replace(/^-/, "")}</span>
                  </li>
                ))}
              </ul>
            </div>
          )
        }

        {/* Legacy Content Fallback (if JSON doesn't match new schema yet) */}
        {
          !modal.roleSummary && modal.content && (
            <div class="prose prose-invert max-w-none">
              {modal.content.map((paragraph, i) => (
                <p key={i} class="mb-4">
                  {paragraph}
                </p>
              ))}
            </div>
          )
        }

        {/* CTA */}
        {
          modal.cta && (
            <div class="mt-4">
              <button
                onclick="demo.showModal()"
                class="bg-white text-black font-bold py-3 px-6 rounded-md hover:bg-gray-200 transition-colors"
              >
                {modal.cta.text || "See How This Role Works In Practice"}
              </button>
            </div>
          )
        }
      </div>
    </div>
  </div>
</dialog>

<style>
  dialog[open]::backdrop {
    backdrop-filter: blur(10px);
    background: rgba(0, 0, 0, 0.8);
  }

  @keyframes scale-up {
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  dialog[open] {
    animation: scale-up 0.3s ease-out forwards;
    opacity: 0;
    transform: scale(0.95) translateY(20px);
  }
</style>
