---
const { modal, index } = Astro.props;
---

<dialog id={`clarity-modal-${index}`} class="fixed inset-0 bg-bs-surface-0 m-auto z-50 p-0 rounded-xl w-full max-w-[95%] md:max-w-4xl max-h-[90vh] overflow-hidden">
  <button 
    onclick="this.closest('dialog').close('close')" 
    aria-label="Close"
    class="absolute top-4 left-4 z-50 bs-btn rounded-full !p-0 flex items-center justify-center h-10 w-10 bg-bs-surface-2 hover:bg-bs-surface-3 transition-colors">
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6">
      <line x1="18" y1="6" x2="6" y2="18"></line>
      <line x1="6" y1="6" x2="18" y2="18"></line>
    </svg>
  </button>

  <div class="overflow-y-auto max-h-[90vh] p-6 md:p-12">
    <div class="grid grid-cols-1 gap-8">
      <div class="flex flex-col gap-6">
        <h2 class="bs-h2 text-gradient uppercase tracking-tight">
          {modal.title}
        </h2>
        
        <div class="prose prose-invert max-w-none">
          {modal.content.map((paragraph, i) => (
            <p key={i} class="mb-4">
              {paragraph}
            </p>
          ))}
        </div>
        
        {modal.cta && (
          <div class="mt-8">
            <button
              onclick="bb_track('cta_click', { cta_name: 'Clarity Modal CTA', cta_location: 'clarity_modal' }); demo.showModal();"
              class="bs-btn"
            >
              {modal.cta.text}
            </button>
          </div>
        )}
      </div>
    </div>
  </div>
</dialog>

<style>
  dialog[open]::backdrop {
    backdrop-filter: blur(50px);
  }

  @keyframes scale-up {
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  dialog[open] {
    animation: scale-up 0.3s ease-out forwards;
    opacity: 0;
    transform: scale(0.9) translateY(20px);
  }
</style>