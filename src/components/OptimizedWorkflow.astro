---
import { Image } from "astro:assets";
import teamMember from "../assets/theme-images/home/team.png";
import aiTeam from "../assets/theme-images/home/home-aiteam.png";

const optimizedWorkflow = Astro.props;

// Icon mapping helper to keep the JSON clean but the visuals rich
const getIcon = (key) => {
    const icons = {
        email: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>`,
        crm: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>`,
        hr: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>`,
        project: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"></path>`,
    };
    return icons[key] || "";
};

const getToolColor = (key) => {
    const colors = {
        email: "indigo",
        crm: "indigo",
        hr: "indigo",
        project: "emerald",
    };
    return colors[key] || "gray";
};
---

<section
    class="relative min-h-screen flex flex-col items-center justify-center py-12 md:py-24 overflow-hidden font-body"
>
    <div
        class="absolute top-0 left-0 w-full h-full overflow-hidden pointer-events-none z-0"
    >
        <div
            class="absolute top-1/4 left-1/4 w-96 h-96 bg-indigo-600/20 rounded-full blur-3xl mix-blend-screen animate-pulse"
            style="animation-duration: 4s;"
        >
        </div>
        <div
            class="absolute bottom-1/4 right-1/4 w-96 h-96 bg-indigo-600/20 rounded-full blur-3xl mix-blend-screen animate-pulse"
            style="animation-duration: 7s;"
        >
        </div>
    </div>

    <div
        class="relative z-10 w-full max-w-7xl px-4 md:px-6 flex flex-col items-center gap-6 md:gap-12"
    >
        <div class="text-center mb-8 reveal-node">
            <h3
                class="bs-h1 tracking-tight mb-4 leading-tight text-gradient text-white"
            >
                {optimizedWorkflow.header.titleLine1}
                <br />
                <span class="text-gradient"
                    >{optimizedWorkflow.header.titleHighlight}</span
                >
            </h3>
            <p class="text-bs-foreground-dark max-w-2xl mx-auto text-lg">
                {optimizedWorkflow.header.description}
            </p>
        </div>

        <div class="w-full flex flex-col items-center relative group">
            <div
                class="glass-panel relative rounded-2xl p-6 md:p-8 w-full max-w-3xl text-center border-t-4 border-indigo-500 reveal-node z-20"
                data-delay="100"
            >
                <Image
                    src={teamMember}
                    alt="Team Member"
                    class="absolute top-0 -z-2 opacity-30 left-0 w-full h-full object-cover rounded-2xl"
                />
                <h3
                    class="text-xs font-bold text-indigo-400 mb-4 uppercase tracking-[0.2em]"
                >
                    {optimizedWorkflow.team.sectionTitle}
                </h3>
                <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                    {
                        optimizedWorkflow.team.roles.map((role) => (
                            <div class="p-4 bg-bs-surface-2 rounded-xl border border-white/5 text-bs-foreground-light hover:bg-bs-surface-3 transition cursor-default">
                                <div class="text-sm font-semibold">{role}</div>
                            </div>
                        ))
                    }
                </div>
            </div>
            <div
                class="connector-vertical hidden lg:block"
                style="top: 100%; height: 0; min-height: 0;"
                data-target-height="3rem"
            >
            </div>
        </div>

        <div
            class="w-full grid grid-cols-1 lg:grid-cols-3 gap-8 items-center relative py-8"
        >
            <div class="order-2 lg:order-1 reveal-node" data-delay="200">
                <div
                    class="glass-panel rounded-2xl p-6 h-full border-l-4 border-emerald-500/50"
                >
                    <div
                        class="flex items-center gap-3 mb-6 border-b border-white/10 pb-4"
                    >
                        <div
                            class="w-3 h-3 rounded-full bg-emerald-400 shadow-[0_0_10px_rgba(52,211,153,0.5)]"
                        >
                        </div>
                        <h3 class="text-lg font-semibold text-white">
                            {optimizedWorkflow.humanWork.title}
                        </h3>
                    </div>
                    <div
                        class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-1 gap-y-3 gap-x-4"
                    >
                        {
                            optimizedWorkflow.humanWork.items.map((item) => (
                                <div class="flex items-center gap-3 text-sm text-bs-foreground-dark group">
                                    <span class="w-1.5 h-1.5 bg-bs-foreground-dark rounded-full group-hover:bg-emerald-400 transition-colors" />
                                    {item}
                                </div>
                            ))
                        }
                    </div>
                </div>
            </div>

            <div
                class="order-1 lg:order-2 flex flex-col items-center justify-center reveal-node z-30"
                data-delay="300"
            >
                <div class="relative group cursor-pointer">
                    <div
                        class="absolute -inset-1 bg-gradient-to-r from-indigo-600 to-indigo-500 rounded-full blur opacity-40 group-hover:opacity-75 transition duration-1000 group-hover:duration-200"
                    >
                    </div>
                    <div
                        class="relative w-48 h-48 md:w-56 md:h-56 rounded-full bg-bs-surface-1 border border-white/10 flex items-center justify-center ai-core-pulse overflow-hidden"
                    >
                        <div
                            class="absolute inset-0 opacity-20"
                            style="background-image: radial-gradient(#6366f1 1px, transparent 1px); background-size: 10px 10px;"
                        >
                        </div>
                        <Image
                            src={aiTeam}
                            alt="AI Team"
                            class="absolute top-0 opacity-30 left-0 w-full h-full object-contain aspect-auto rounded-2xl"
                        />

                        <div class="text-center p-4 relative z-10">
                            <svg
                                class="w-12 h-12 text-indigo-400 mx-auto mb-2 drop-shadow-[0_0_10px_rgba(99,102,241,0.8)]"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                                ><path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="1.5"
                                    d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"
                                ></path></svg
                            >
                            <h2
                                class="text-2xl font-bold text-white tracking-tight whitespace-pre-line"
                            >
                                {optimizedWorkflow.aiCore.title}
                            </h2>
                        </div>
                    </div>
                </div>

                <div class="mt-6 text-center">
                    <span
                        class="inline-flex items-center rounded-full bg-indigo-400/10 px-3 py-1 text-xs font-medium text-indigo-400 ring-1 ring-inset ring-indigo-400/20"
                    >
                        {optimizedWorkflow.aiCore.badge}
                    </span>
                </div>
            </div>

            <div class="order-3 lg:order-3 reveal-node" data-delay="400">
                <div
                    class="glass-panel rounded-2xl p-6 h-full border-r-4 border-indigo-500/50"
                >
                    <div
                        class="flex items-center gap-3 mb-6 border-b border-white/10 pb-4"
                    >
                        <div
                            class="w-3 h-3 rounded-full bg-indigo-400 shadow-[0_0_10px_rgba(99,102,241,0.5)]"
                        >
                        </div>
                        <h3 class="text-lg font-semibold text-white">
                            {optimizedWorkflow.automatedWork.title}
                        </h3>
                    </div>
                    <div
                        class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-1 gap-y-3 gap-x-4"
                    >
                        {
                            optimizedWorkflow.automatedWork.items.map(
                                (item) => (
                                    <div class="flex items-center gap-3 text-sm text-bs-foreground-dark group">
                                        <span class="text-indigo-400 opacity-50 group-hover:opacity-100 transition">
                                            ⚡
                                        </span>
                                        {item}
                                    </div>
                                ),
                            )
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="w-full flex flex-col items-center relative">
            <div
                class="connector-vertical hidden lg:block"
                style="bottom: 100%; height: 0; min-height: 0;"
                data-target-height="3rem"
            >
            </div>

            <div
                class="glass-panel rounded-2xl p-6 md:p-10 w-full max-w-3xl border-b-4 border-indigo-500 reveal-node z-20"
                data-delay="500"
            >
                <h3
                    class="text-xs font-bold text-indigo-400 mb-8 text-center uppercase tracking-[0.2em]"
                >
                    {optimizedWorkflow.tools.sectionTitle}
                </h3>

                <div class="flex flex-wrap justify-center gap-4 md:gap-10">
                    {
                        optimizedWorkflow.tools.list.map((tool) => {
                            const color = getToolColor(tool.key);
                            // Dynamic class construction
                            const bgClass = `group-hover:bg-${color}-500/10`;
                            const borderClass = `group-hover:border-${color}-400`;
                            const textClass = `group-hover:text-${color}-300`;

                            return (
                                <div class="flex flex-col items-center gap-3 group w-24">
                                    <div
                                        class={`w-16 h-16 bg-bs-surface-2 rounded-2xl flex items-center justify-center border border-white/10 transition-all duration-300 shadow-lg ${borderClass} ${bgClass}`}
                                    >
                                        <svg
                                            class={`w-7 h-7 text-bs-foreground-dark ${textClass}`}
                                            fill="none"
                                            stroke="currentColor"
                                            viewBox="0 0 24 24"
                                            set:html={getIcon(tool.key)}
                                        />
                                    </div>
                                    <span class="text-xs font-medium text-bs-foreground-dark group-hover:text-bs-foreground-light transition">
                                        {tool.name}
                                    </span>
                                </div>
                            );
                        })
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    /* --- Glassmorphism & Custom CSS --- */
    .glass-panel {
        background: rgba(24, 24, 27, 0.6);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid rgba(255, 255, 255, 0.08);
        box-shadow: 0 4px 30px rgba(0, 0, 0, 0.2);
        transition:
            transform 0.3s ease,
            border-color 0.3s ease,
            box-shadow 0.3s ease;
    }

    .glass-panel:hover {
        transform: translateY(-5px);
        border-color: rgba(99, 102, 241, 0.4);
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
    }

    /* --- Animations --- */
    .reveal-node {
        opacity: 0;
        transform: translateY(30px);
        transition: all 0.8s cubic-bezier(0.16, 1, 0.3, 1);
        will-change: transform, opacity;
    }

    .reveal-node.visible {
        opacity: 1;
        transform: translateY(0);
    }

    .ai-core-pulse {
        animation: pulse-glow 3s infinite;
    }

    @keyframes pulse-glow {
        0% {
            box-shadow: 0 0 0 0 rgba(99, 102, 241, 0.4);
        }
        70% {
            box-shadow: 0 0 0 20px rgba(99, 102, 241, 0);
        }
        100% {
            box-shadow: 0 0 0 0 rgba(99, 102, 241, 0);
        }
    }

    /* Connectors */
    .connector-vertical {
        width: 2px;
        background: linear-gradient(
            to bottom,
            rgba(255, 255, 255, 0.05),
            #6366f1,
            rgba(255, 255, 255, 0.05)
        );
        height: 0;
        transition: height 1.5s ease-out;
        position: absolute;
        left: 50%;
        transform: translateX(-50%);
        z-index: 0;
    }

    .connector-vertical.active {
        /* Height is controlled via JS, but this class tracks state */
    }
</style>

<script>
    function initAnimations() {
        const observerOptions = {
            threshold: 0.15,
            rootMargin: "0px",
        };

        const observer = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
                if (entry.isIntersecting) {
                    // Activate Node
                    entry.target.classList.add("visible");

                    // Handle staggering delay
                    const delay = entry.target.dataset.delay || 0;
                    (entry.target as HTMLElement).style.transitionDelay =
                        `${delay}ms`;

                    // If this element makes the AI Core visible, trigger connectors
                    if (
                        entry.target.querySelector(".ai-core-pulse") ||
                        entry.target.closest(".ai-core-pulse")
                    ) {
                        triggerConnectors();
                    }

                    observer.unobserve(entry.target);
                }
            });
        }, observerOptions);

        const elements = document.querySelectorAll(".reveal-node");
        elements.forEach((el) => observer.observe(el));

        function triggerConnectors() {
            const lines = document.querySelectorAll(".connector-vertical");
            lines.forEach((line) => {
                const targetHeight =
                    (line as HTMLElement).dataset.targetHeight || "3rem";
                (line as HTMLElement).style.height = targetHeight;
            });
        }

        // Fallback: Trigger connectors if AI Core is already in view (short screens)
        setTimeout(() => {
            triggerConnectors();
        }, 1000);
    }

    // Run on load
    initAnimations();

    // Support for View Transitions (Astro 3.0+)
    document.addEventListener("astro:page-load", initAnimations);
</script>
