---
// src/components/InteractiveFeatures.astro

import home from "../data/home.json";
const { title, subtitle, cards } = home.problem_cards;
---

<section class="relative text-gray-200 bs-container">

  <div
    class="relative z-10 min-h-screen flex items-center justify-center p-4 sm:py-6 lg:py-24"
  >
    <div class="max-w-7xl w-full mx-auto">
      <div class="text-center mb-12 md:mb-16">
        <h2 class="bs-h2 !text-4xl sm:!text-5xl font-bold text-white tracking-tight">
          {title}
        </h2>
        <p class="mt-4 text-lg text-gray-400 max-w-md mx-auto">
          {subtitle}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div
          class="ai-card rounded-2xl p-6 md:col-span-2 flex flex-col justify-between"
        >
          <div class="card-content">
            <div>
              <div class="flex items-center gap-3 mb-4">
                <div
                  class="bg-red-500/10 p-2 rounded-lg border border-red-500/30"
                  set:html={cards[0].icon}
                />
                <h3 class="text-xl font-semibold text-white">
                  {cards[0].title}
                </h3>
              </div>
              <p class="text-gray-400 leading-relaxed">
                {cards[0].description}
              </p>
            </div>
            <div class="mt-6" set:html={cards[0].visualHTML} />
          </div>
        </div>

        <div class="ai-card rounded-2xl p-6 flex flex-col justify-between">
          <div class="card-content">
            <div>
              <div class="flex items-center gap-3 mb-4">
                <div
                  class="bg-yellow-500/10 p-2 rounded-lg border border-yellow-500/30"
                  set:html={cards[1].icon}
                />
                <h3 class="text-xl font-semibold text-white">
                  {cards[1].title}
                </h3>
              </div>
              <p class="text-gray-400 leading-relaxed">
                {cards[1].description}
              </p>
            </div>
            <div class="mt-6" set:html={cards[1].visualHTML} />
          </div>
        </div>

        <div
          class="ai-card rounded-2xl p-6 md:col-span-3 flex flex-col md:flex-row items-center gap-6"
        >
          <div class="card-content w-full md:w-1/2">
            <div class="flex items-center gap-3 mb-4">
              <div
                class="bg-blue-500/10 p-2 rounded-lg border border-blue-500/30"
                set:html={cards[2].icon}
              />
              <h3 class="text-xl font-semibold text-white">{cards[2].title}</h3>
            </div>
            <p class="text-gray-400 leading-relaxed">
              {cards[2].description}
            </p>
          </div>
          <div
            class="card-content w-full md:w-1/2"
            set:html={cards[2].visualHTML}
          />
        </div>
      </div>
    </div>
  </div>
</section>

<style>


  .card-content {
    position: relative;
    z-index: 2;
  }
</style>


