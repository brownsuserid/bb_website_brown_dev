---

import Arrow from '../assets/theme-images/icon-arrow.svg'

const { question, answer } = Astro.props

---

<details name="faq"
class="group bg-bs-surface-2 group hover:bg-bs-surface-3 open:bg-bs-surface-3 transition-colors w-full shadow-md rounded-lg bs-h3 ">

  <!-- Summary -->
  <summary class="flex gap-3 justify-between items-center p-6 py-5 group-hover:text-black group-open:text-black">

    <!-- Title -->
    <span class="select-none group-hover:text-black group-open:text-black" set:html={ question } />

    <!-- Icon -->
    <span>
      <Arrow class="opacity-60 group-hover:text-black group-open:text-black h-4 w-4 transition -rotate-90 group-open:rotate-90 ease-bs-bounce duration-1000" height="16" width="25" />
    </span>
  </summary>

  <!-- Content -->
  <div class="anim-wrapper max-w-none">

    <div set:html={ answer } class="p-6 group-hover:text-black group-open:text-black" />

  </div>

</details>


<style>

summary::-webkit-details-marker {
  display: none
}

details {

  @media (prefers-reduced-motion: no-preference) {
    interpolate-size: allow-keywords;
  }

  &::details-content {
    block-size: 0;
    opacity: 0;
    overflow-y: clip;
    transition: content-visibility 1s allow-discrete, opacity 1s, block-size 1s var(--ease-bs-bounce);
  }

  &[open]::details-content {
    block-size: auto;
    opacity: 1;
  }
}

</style>
