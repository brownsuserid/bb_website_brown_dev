---
interface Props {
  headline: string;
  subheadline: string;
  blocks: {
    title: string;
    content: string;
    isCTA?: boolean;
    buttonText?: string;
    items?: string[];
  }[];
}

const { headline, subheadline, blocks } = Astro.props;
---

<section class="relative py-16 sm:py-20 lg:py-28 overflow-hidden bg-black">
  <div class="bs-container relative">
    <div class="text-center mb-20 space-y-6 relative z-10">
      <h2 class="bs-h2 text-white">{headline}</h2>
      <p class="bs-h3 text-gray-400 max-w-4xl mx-auto leading-relaxed">
        {subheadline}
      </p>
    </div>

    <canvas id="neuron-canvas" class="absolute inset-0 w-full h-full pointer-events-none"></canvas>

    <div class="relative z-10 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-12 lg:gap-20">
      {blocks.map((block, index) => (
        <div
          class={`neuron-node group relative opacity-0 intersect:opacity-100 transition-all duration-1000 ease-out ${
            block.isCTA ? 'md:col-span-2 lg:col-span-1' : ''
          }`}
          style={`transition-delay: ${index * 200}ms`}
          data-node-index={index}
        >
          <div class="absolute -inset-8 opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none">
            <div class="absolute inset-0 rounded-full border-2 border-gray-500/30 animate-pulse-ring"></div>
            <div class="absolute inset-4 rounded-full border-2 border-gray-600/30 animate-pulse-ring" style="animation-delay: 0.5s"></div>
            <div class="absolute inset-8 rounded-full border-2 border-gray-700/30 animate-pulse-ring" style="animation-delay: 1s"></div>
          </div>

          <div class="relative pt-12">
            <div class={`absolute -top-6 left-1/2 -translate-x-1/2 w-20 h-20 rounded-full flex items-center justify-center transition-all duration-500 group-hover:scale-125 z-20 ${
              block.isCTA 
                ? 'bg-gradient-to-br from-gray-200 via-gray-400 to-gray-500 shadow-2xl shadow-gray-400/60' 
                : 'bg-gradient-to-br from-gray-800 via-gray-700 to-gray-600 shadow-2xl shadow-gray-900/60'
            }`}>
              <div class="w-12 h-12 rounded-full bg-white/20 backdrop-blur-sm flex items-center justify-center">
                <span class="text-white font-bold text-2xl">{index + 1}</span>
              </div>
              <div class="absolute inset-0 rounded-full overflow-hidden">
                {[...Array(6)].map((_, i) => (
                  <div 
                    class="particle absolute w-1 h-1 bg-white rounded-full"
                    style={`
                      top: 50%;
                      left: 50%;
                      animation: particle-float 3s infinite;
                      animation-delay: ${i * 0.5}s;
                      transform: rotate(${i * 60}deg);
                    `}
                  ></div>
                ))}
              </div>
            </div>

            <div class={`relative mt-8 p-8 rounded-3xl backdrop-blur-md border-2 transition-all duration-500 group-hover:scale-105 group-hover:-translate-y-2 ${
              block.isCTA 
                ? 'bg-gray-800/50 border-gray-600/50 group-hover:border-gray-400 group-hover:shadow-2xl group-hover:shadow-gray-500/30' 
                : 'bg-black/70 border-gray-800/50 group-hover:border-gray-600/50 group-hover:shadow-2xl group-hover:shadow-gray-700/20'
            }`}>
              
              <div class="absolute -top-2 left-1/4 w-3 h-3 rounded-full bg-gray-500 shadow-lg shadow-gray-400/50 synapse-dot"></div>
              <div class="absolute -bottom-2 right-1/4 w-3 h-3 rounded-full bg-gray-500 shadow-lg shadow-gray-400/50 synapse-dot"></div>
              <div class="absolute top-1/3 -left-2 w-3 h-3 rounded-full bg-gray-500 shadow-lg shadow-gray-400/50 synapse-dot"></div>
              <div class="absolute top-2/3 -right-2 w-3 h-3 rounded-full bg-gray-500 shadow-lg shadow-gray-400/50 synapse-dot"></div>

              <h3 class="bs-h3 text-white mb-6 relative z-10">
                {block.title}
              </h3>

              <div class="flex-grow space-y-4 relative z-10">
                {block.items ? (
                  <ul class="space-y-4">
                    {block.items.map((item) => (
                      <li class="flex items-start gap-3 text-gray-400 group/item hover:text-white transition-colors">
                        <span class="text-gray-500 mt-1 flex-shrink-0 text-xl">●</span>
                        <span class="leading-relaxed">{item}</span>
                      </li>
                    ))}
                  </ul>
                ) : (
                  <p class="text-gray-400 leading-relaxed group-hover:text-white transition-colors">{block.content}</p>
                )}
              </div>

              {block.isCTA && block.buttonText && (
                <button
                  type="button"
                  class="bs-btn-mono mt-8 w-full relative overflow-hidden group-hover:scale-105 transition-transform duration-300"
                  onclick={`bb_track('cta_click', { cta_name: '${block.buttonText}', cta_location: 'brainy_story' }); demo.showModal();`}
                >
                  <span class="relative z-10">{block.buttonText}</span>
                  <div class="absolute inset-0 bg-gradient-to-r from-gray-700 to-gray-900 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                </button>
              )}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  /* Define a monochrome button style if bs-btn relies on gradients */
  .bs-btn-mono {
    /* Base styles from your .bs-btn class */
    padding: 0.75rem 1.5rem;
    background-color: #374151; /* gray-700 */
    color: white;
    border-radius: 0.5rem;
    font-weight: 600;
    text-align: center;
    border: 1px solid #4b5563; /* gray-600 */
  }

  /* Pulse Ring Animation */
  @keyframes pulse-ring {
    0%, 100% {
      transform: scale(1);
      opacity: 0.3;
    }
    50% {
      transform: scale(1.2);
      opacity: 0.1;
    }
  }

  .animate-pulse-ring {
    animation: pulse-ring 3s ease-in-out infinite;
  }

  /* Particle Float Animation */
  @keyframes particle-float {
    0% {
      transform: translate(-50%, -50%) translateX(0) scale(1);
      opacity: 1;
    }
    50% {
      opacity: 0.5;
    }
    100% {
      transform: translate(-50%, -50%) translateX(40px) scale(0);
      opacity: 0;
    }
  }

  /* Synapse Dot Pulse */
  .synapse-dot {
    animation: synapse-pulse 2s ease-in-out infinite;
  }

  @keyframes synapse-pulse {
    0%, 100% {
      transform: scale(1);
      opacity: 1;
    }
    50% {
      transform: scale(1.5);
      opacity: 0.6;
    }
  }

  /* Neuron Node Animations */
  .neuron-node {
    transform: translateY(30px) scale(0.95);
  }

  .neuron-node.intersect\:opacity-100 {
    transform: translateY(0) scale(1);
  }

  @media (hover: hover) {
    .neuron-node:hover {
      z-index: 20;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const canvas = document.getElementById('neuron-canvas') as HTMLCanvasElement;
    if (!canvas) return;

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    // Set canvas size
    function resizeCanvas() {
      canvas.width = canvas.offsetWidth;
      canvas.height = canvas.offsetHeight;
    }
    resizeCanvas();
    window.addEventListener('resize', resizeCanvas);

    const nodes = document.querySelectorAll('.neuron-node') as NodeListOf<HTMLElement>;
    const nodePositions: { x: number; y: number }[] = [];

    // Get node positions
    function updateNodePositions() {
      nodePositions.length = 0;
      nodes.forEach((node) => {
        const rect = node.getBoundingClientRect();
        const canvasRect = canvas.getBoundingClientRect();
        nodePositions.push({
          x: rect.left - canvasRect.left + rect.width / 2,
          y: rect.top - canvasRect.top + 60, // Offset to center of sphere
        });
      });
    }

    // Draw neural connections
    function drawConnections() {
      if (!ctx) return;
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      
      // Draw lines between nodes
      for (let i = 0; i < nodePositions.length; i++) {
        for (let j = i + 1; j < nodePositions.length; j++) {
          const start = nodePositions[i];
          const end = nodePositions[j];
          
          // Create gradient for line (monochrome)
          const gradient = ctx.createLinearGradient(start.x, start.y, end.x, end.y);
          gradient.addColorStop(0, 'rgba(255, 255, 255, 0.3)');
          gradient.addColorStop(0.5, 'rgba(255, 255, 255, 0.2)');
          gradient.addColorStop(1, 'rgba(255, 255, 255, 0.3)');
          
          ctx.strokeStyle = gradient;
          ctx.lineWidth = 2;
          ctx.setLineDash([5, 10]);
          
          ctx.beginPath();
          ctx.moveTo(start.x, start.y);
          
          // Bezier curve for organic feel
          const midX = (start.x + end.x) / 2;
          const midY = (start.y + end.y) / 2;
          const offset = 50;
          ctx.quadraticCurveTo(midX + offset, midY - offset, end.x, end.y);
          
          ctx.stroke();
          
          // Draw animated particles along the line
          drawParticle(start, end, Date.now() / 2000 + i * 0.3);
        }
      }
    }

    // Draw animated particle (monochrome)
    function drawParticle(start: { x: number; y: number }, end: { x: number; y: number }, time: number) {
      if (!ctx) return;
      const t = (time % 1);
      const x = start.x + (end.x - start.x) * t;
      const y = start.y + (end.y - start.y) * t;
      
      ctx.fillStyle = 'rgba(255, 255, 255, 0.8)';
      ctx.beginPath();
      ctx.arc(x, y, 3, 0, Math.PI * 2);
      ctx.fill();
      
      // Glow effect (monochrome)
      ctx.fillStyle = 'rgba(255, 255, 255, 0.3)';
      ctx.beginPath();
      ctx.arc(x, y, 6, 0, Math.PI * 2);
      ctx.fill();
    }

    // Animation loop
    function animate() {
      drawConnections();
      requestAnimationFrame(animate);
    }

    // Initialize
    setTimeout(() => {
      updateNodePositions();
      animate();
    }, 500);

    // Update on scroll and resize
    window.addEventListener('scroll', updateNodePositions, { passive: true });
    window.addEventListener('resize', updateNodePositions);

    // Interactive hover effects
    nodes.forEach((node, index) => {
      node.addEventListener('mouseenter', () => {
        nodes.forEach((otherNode, otherIndex) => {
          if (otherIndex !== index) {
            otherNode.style.opacity = '0.4';
            otherNode.style.filter = 'blur(2px)';
          }
        });
      });

      node.addEventListener('mouseleave', () => {
        nodes.forEach((otherNode) => {
          otherNode.style.opacity = '1';
          otherNode.style.filter = 'none';
        });
      });
    });
  });
</script>