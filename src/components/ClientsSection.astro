---
const {
  title,
  clients,
  logoClass = "opacity-60 max-w-32 min-h-16 group-hover:scale-[1.05] group-hover:-translate-y-1 group-hover:opacity-100 group-hover:-rotate-1 ease-bs-bounce transition-all duration-1000",
} = Astro.props;

let newCssClasses = "grid grid-cols-2 place-content-center gap-4";
if (title.includes("Onboard")) {
  newCssClasses =
    "grid grid-cols-2 md:grid-cols-4 lg:grid-cols-5 place-content-center gap-4";
}
---

<section
  class="anim-wrapper bs-container bs-mt-lg relative overflow-hidden rounded-3xl py-12 px-4 group/section"
>
  <!-- Holographic Minimalist Pattern Background -->
  <div
    class="absolute inset-0 -z-10 transition-opacity duration-1000 opacity-60"
  >
    <!-- Gradient Blobs -->
    <div
      class="absolute -top-40 -left-40 w-96 h-96 bg-purple-500/10 rounded-full blur-[100px] group-hover/section:bg-purple-500/20 transition-all duration-700"
    >
    </div>
    <div
      class="absolute -bottom-40 -right-40 w-96 h-96 bg-cyan-500/10 rounded-full blur-[100px] group-hover/section:bg-cyan-500/20 transition-all duration-700"
    >
    </div>

    <!-- Holographic Sheen (Angled Gradient) -->
    <div
      class="absolute inset-0 bg-[linear-gradient(115deg,transparent_40%,rgba(255,255,255,0.03)_45%,rgba(255,255,255,0.05)_50%,rgba(255,255,255,0.03)_55%,transparent_60%)] opacity-70"
    >
    </div>

    <!-- Subtle Grid Overlay -->
    <div
      class="absolute inset-0 bg-[url('data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMjAiIGhlaWdodD0iMjAiIHhtbG5zPSJodHRwOi8vd3d3LnczLm9yZy8yMDAwL3N2ZyI+PGNpcmNsZSBjeD0iMSIgY3k9IjEiIHI9IjEiIGZpbGw9InJnYmEoMjU1LDI1NSwyNTUsMC4wNSkiLz48L3N2Zz4=')] opacity-30"
    >
    </div>

    <!-- Glassmorphism Border -->
    <div
      class="absolute inset-0 rounded-3xl border border-white/5 bg-white/5 backdrop-blur-[2px]"
    >
    </div>
  </div>

  <div class="relative z-10 grid">
    <!-- Title -->
    {title && <h2 class="bs-h2 text-center mb-8" set:html={title} />}

    <!-- Logos -->
    <div class={newCssClasses}>
      <!-- Logo link -->
      {
        clients.map((item) => (
          <div class="group py-10 flex flex-col items-center px-5 rounded-xl flex place-content-center bg-bs-surface-2/40 hover:bg-bs-surface-2/80 transition-colors duration-300 backdrop-blur-sm border border-white/5 hover:border-white/10">
            <img
              src={item.image}
              alt={item.title}
              class={logoClass}
              width="140"
              height="40"
              loading="lazy"
            />
            <span class="mt-2 text-sm text-gray-400 group-hover:text-white transition-colors">
              {item.title}
            </span>
          </div>
        ))
      }
    </div>
  </div>
</section>
